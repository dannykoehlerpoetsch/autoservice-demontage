# Mailversand für Terminanfragen (optional)
#
# Ohne Angabe sagt die Bestätigungsseite offen, dass kein Mailversand eingerichtet ist,
# und die Anfrage steht nur im Server-Log. Für den Versand gilt: Resend vor SMTP.
#
# Diese Datei ist eine Vorlage – die echten Zugangsdaten gehören in .env.local.

# Variante 1: Resend
RESEND_API_KEY=
MAIL_FROM=Angaben <antwort@example.com>
MAIL_REPLY_TO=

# Variante 2: SMTP – entweder eine URL oder Host/Port/Pad
SMTP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
