{
  "name": "autoservice-demontage",
  "version": "1.0.0",
  "description": "Portfolio demo of a fictional independent auto repair shop: Next.js 16 App Router, next-intl, Radix UI, Zod-validated demo appointment flow with an in-browser email preview, Vitest unit tests, Playwright E2E with axe-core accessibility and responsive checks, indexable production pages with sitemap and canonical URLs.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "fmt": "prettier --write src e2e playwright.config.ts vitest.config.ts vitest.setup.ts",
    "fmt:check": "prettier --check src e2e playwright.config.ts vitest.config.ts vitest.setup.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dannykoehlerpoetsch/autoservice-demontage.git"
  },
  "keywords": [
    "nextjs",
    "react",
    "typescript",
    "tailwindcss",
    "next-intl",
    "playwright",
    "vitest",
    "accessibility",
    "portfolio-demo"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/dannykoehlerpoetsch/autoservice-demontage/issues"
  },
  "homepage": "https://github.com/dannykoehlerpoetsch/autoservice-demontage#readme",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "16.4.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "autoprefixer": "^10.5.4",
    "eslint": "9",
    "eslint-config-next": "16.4.5",
    "eslint-plugin-n": "^18.2.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "lucide-react": "^1.28.0",
    "next": "16.4.5",
    "next-intl": "^4.14.9",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.8",
    "zod": "^4.6.7"
  }
}
